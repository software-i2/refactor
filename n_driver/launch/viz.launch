<?xml version="1.0"?>
<launch>
    <!-- meshes come from n_desc, as file:// absolute paths -->
    <param name="robot_description"
           command="$(find xacro)/xacro $(find n_driver)/urdf/arm.urdf.xacro"/>

    <node name="robot_state_publisher" pkg="robot_state_publisher"
          type="robot_state_publisher"/>
</launch>
